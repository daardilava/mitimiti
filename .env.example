# Copy to .env and fill in. `npx supabase status` prints the local values after `npm run db:start`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key

# Clerk Dashboard › API keys. Development keys start with pk_test_.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key

# 1 = skip sign-in and use sample data so every screen is reachable before the backend is wired.
EXPO_PUBLIC_DEV_BYPASS_AUTH=0

# RevenueCat › Project settings › API keys: the PUBLIC app-specific keys (iOS appl_…, Android goog_…).
# Leave empty to run without purchases (the paywall then says the store is unavailable).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Server-side secrets never go here (everything above ships inside the app): REVENUECAT_WEBHOOK_AUTH and
# REVENUECAT_SECRET_API_KEY are set with `npx supabase secrets set`; see README › Deploy the billing webhook.
