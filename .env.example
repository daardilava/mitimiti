# Copy to .env and fill in. `npx supabase status` prints the local values after `npm run db:start`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key

# Clerk Dashboard › API keys. Development keys start with pk_test_.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key

# 1 = skip sign-in and use sample data so every screen is reachable before the backend is wired.
EXPO_PUBLIC_DEV_BYPASS_AUTH=0

# Server-side secrets never go here (everything above ships inside the app). The billing webhook's
# REVENUECAT_WEBHOOK_AUTH is set with `npx supabase secrets set`; see README › Deploy the billing webhook.
