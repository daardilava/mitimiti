{
  "expo": {
    "name": "MitiMiti",
    "slug": "a-medias",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mitimiti.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2238",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mitimiti.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      "@clerk/expo",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en",
              "de"
            ],
            "android": [
              "es",
              "en",
              "de"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F5F4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#1A2238"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MitiMiti usa el micrófono solo mientras dictas un gasto, para escribirlo por ti.",
          "speechRecognitionPermission": "MitiMiti convierte lo que dictas en texto para registrar el gasto, con el reconocimiento de voz de Apple. El audio no se envía a MitiMiti."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MitiMiti usa la cámara para fotografiar un recibo y leer la tienda, la fecha y el total. La foto no se guarda.",
          "microphonePermission": "MitiMiti usa el micrófono solo mientras dictas un gasto, para escribirlo por ti.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MitiMiti usa la cámara para fotografiar un recibo y leer el total. La foto no se guarda.",
          "photosPermission": "MitiMiti abre tus fotos para que elijas un recibo y leer el total. La foto no se guarda.",
          "microphonePermission": "MitiMiti usa el micrófono solo mientras dictas un gasto, para escribirlo por ti."
        }
      ]
    ],
    "scheme": "mitimiti",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8648d437-b63c-485a-a1fd-49751e4eae06"
      }
    },
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json",
      "de": "./locales/de.json"
    },
    "owner": "diegovargas"
  }
}
